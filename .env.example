# 家里两个人的 QQ 号，插件靠这个认人
DAFEIYU_DAD_QQ=
DAFEIYU_MOM_QQ=

# 提示词里显示的名字，不填就是「爸爸」「妈妈」
DAFEIYU_DAD_NAME=爸爸
DAFEIYU_MOM_NAME=妈妈

# 主要活动群
DAFEIYU_GROUP_ID=

# 语音合成：参考音频和接口地址
DAFEIYU_TTS_REF=/path/to/your/ref.wav
DAFEIYU_TTS_API=http://host.docker.internal:9880/tts

# 唱歌服务和浏览器服务
DAFEIYU_SING_API=http://host.docker.internal:9881/sing
DAFEIYU_BROWSER_API=http://host.docker.internal:9882

# 走 SnowLuma 的空间动作才需要
SNOWLUMA_TOKEN=
